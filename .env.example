# Discord Developer Portal -> your application
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=

# Fine-grained GitHub token, scoped to your project repo only.
# Permissions: Issues, Pull requests, Contents -> Read and write.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Public URL Hive Workers use to reach this bot. Only needed for the "workers" builder.
PUBLIC_URL=

# Node only
PORT=8787
DB_PATH=hive.db
