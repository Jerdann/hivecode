# HiveCode settings for the Node option. Fill in the value after each "=" (no quotes).
# Full guide: README -> "Your settings and where to find them".

# https://discord.com/developers/applications -> your app -> General Information -> Application ID -> Copy
DISCORD_APP_ID=
# Same page -> Public Key -> Copy (only used on Cloudflare; fine to leave empty for Node)
DISCORD_PUBLIC_KEY=
# Same app -> Bot (left sidebar) -> Reset Token -> Copy. Never share it.
DISCORD_TOKEN=

# https://github.com/settings/personal-access-tokens/new -> only your project repo,
# Contents + Issues + Pull requests: Read and write. Starts with github_pat_
GITHUB_TOKEN=
# Your project repo (the app the hive builds) as owner/name, e.g. Jerdann/my-app
GITHUB_REPO=

# Public address Hive Workers use to reach this bot. Leave empty unless you use the "workers" builder.
PUBLIC_URL=

# Leave these as they are.
PORT=8787
DB_PATH=hive.db
